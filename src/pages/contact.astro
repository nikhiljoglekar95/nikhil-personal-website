---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.js';
---
<Base title="Contact" active="contact" description="Connect with Nikhil Joglekar for professional conversations about privacy, data protection and responsible AI."><section class="page-head container"><span class="kicker">START A CONVERSATION</span><h1>Good ideas begin<br/>with a <em>conversation.</em></h1><p>Whether you're exchanging perspectives, sharing an interesting question or exploring a professional collaboration, I'd be glad to connect.</p></section><div class="container page-rule"></div><section class="container section contact-grid"><div><span class="kicker">WAYS TO REACH ME</span><h2>Let's connect.</h2><p>This is a space for thoughtful professional exchanges about privacy, AI governance and digital trust.</p></div><div class="contact-options">{site.linkedin ? <a href={site.linkedin} target="_blank" rel="noopener noreferrer"><span><small>PROFESSIONAL NETWORK</small><strong>Connect on LinkedIn</strong></span><span>↗</span></a> : <div class="contact-placeholder"><small>LINKEDIN</small><strong>Profile link to be added</strong><p>Update src/config/site.js with your LinkedIn URL.</p></div>}{site.email ? <a href={`mailto:${site.email}`}><span><small>DIRECT MESSAGE</small><strong>{site.email}</strong></span><span>↗</span></a> : <div class="contact-placeholder"><small>EMAIL</small><strong>Public email to be added</strong><p>Update src/config/site.js to enable direct email.</p></div>}<p class="contact-note">Please avoid sharing sensitive or confidential information in initial messages. Content on this site is not legal advice.</p></div></section></Base>
