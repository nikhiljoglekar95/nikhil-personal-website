---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site.js';
const articles = (await getCollection('insights', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base active="home">
<section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-line"></span> PRIVACY · AI GOVERNANCE · DIGITAL TRUST</div><h1>Making sense of <em>privacy</em> in an AI-driven world<span class="gold-period">.</span></h1><p class="hero-lead">Clear perspectives on complex regulations, responsible innovation, and what it takes to build trust in a data-driven world.</p><div class="button-row"><a class="button button-dark" href="/insights">Explore my insights <span aria-hidden="true">↗</span></a><a class="text-link" href="/about">A little about me <span aria-hidden="true">→</span></a></div><div class="hero-signature"><span class="signature-mark">NJ</span><span>Nikhil Joglekar <small>{site.role} · {site.credentials}</small></span></div></div><div class="hero-art" role="img" aria-label="Abstract architectural graphic with layered circles and elegant lines"><div class="hero-frame"><span class="hero-ring ring-one"></span><span class="hero-ring ring-two"></span><span class="hero-ring ring-three"></span><span class="hero-cross">✳</span><div class="hero-art-caption">THE FUTURE OF TRUST<br/>IS BUILT WITH INTENTION.</div><div class="hero-art-index">01 / PERSPECTIVES</div></div></div></section>
<div class="container"><div class="hero-divider"><span>THE WORK & THE THINKING</span><span>SCROLL TO EXPLORE ↓</span></div></div>
<section class="section container" id="focus"><div class="section-intro"><span class="kicker">01 / AREAS OF FOCUS</span><h2>Where law, technology<br/>and <em>trust</em> intersect.</h2><p>Exploring both the regulatory landscape and the practical decisions behind responsible data use.</p></div><div class="focus-grid"><a class="focus-card" href="/insights"><span class="focus-icon">◎</span><span class="focus-number">01</span><h3>Privacy & Data<br/>Protection</h3><p>Making sense of privacy law, data rights, accountability and the evolving expectations placed on organizations.</p><span class="focus-arrow">↗</span></a><a class="focus-card" href="/insights"><span class="focus-icon">✳</span><span class="focus-number">02</span><h3>AI Governance<br/>& Regulation</h3><p>Understanding how organizations can navigate emerging AI rules, manage risk and put responsible AI into practice.</p><span class="focus-arrow">↗</span></a><a class="focus-card" href="/insights"><span class="focus-icon">▧</span><span class="focus-number">03</span><h3>Privacy<br/>in Practice</h3><p>Moving beyond policies into the real work of assessments, contracting, operations and privacy-by-design.</p><span class="focus-arrow">↗</span></a></div></section>
<section class="dark-band"><div class="container band-grid"><span class="kicker kicker-light">A NOTE ON APPROACH</span><div><blockquote>“Good governance isn't about making technology stand still. It's about helping innovation move forward with purpose.”</blockquote><p>My work sits at the intersection of legal obligations, organizational decisions and emerging technology.</p></div></div></section>
<section class="section container"><div class="section-heading"><div><span class="kicker">02 / IDEAS & PERSPECTIVES</span><h2>Latest <em>thinking.</em></h2></div><a class="text-link" href="/insights">All insights <span aria-hidden="true">↗</span></a></div>{articles.length > 0 ? <div class="articles-grid">{articles.map((a,i)=><ArticleCard article={a} index={i}/>)}</div> : <div class="empty-state"><h3>Thoughtful writing, coming soon.</h3><p>Articles on privacy, AI governance and practical data protection will appear here once they are ready to publish.</p><a class="text-link" href="/insights">View planned topics →</a></div>}</section>
<section class="about-teaser"><div class="container about-teaser-inner"><div class="about-ornament" aria-hidden="true"><div class="ornament-circle">NJ<span>.</span></div></div><div class="about-teaser-copy"><span class="kicker">03 / BEHIND THE PERSPECTIVE</span><h2>Regulation is the starting point. <em>Understanding</em> is the goal.</h2><p>I'm Nikhil — a privacy and data protection professional interested in the space where regulation meets real-world decision-making. I write to unpack what changing rules mean, how they interact with technology, and why practical implementation matters.</p><a href="/about" class="button button-outline">More about me <span aria-hidden="true">↗</span></a></div></div></section>
<section class="container closing-cta"><span class="kicker">LET'S KEEP THE CONVERSATION GOING</span><h2>Better questions.<br/><em>Better conversations.</em></h2><p>Exploring a question about privacy, AI or digital trust? I’m always interested in thoughtful professional exchanges.</p><a href="/contact" class="button button-dark">Get in touch <span aria-hidden="true">↗</span></a></section>
</Base>
